# --- Database ---
# Production: PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/linguaflow"
# Development (mặc định, chạy ngay không cần Postgres):
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Tạo bằng: npx auth secret
AUTH_SECRET="dev-secret-change-me-in-production-0123456789abcdef"
AUTH_TRUST_HOST=true

# Google OAuth (để trống nếu chưa có - Đăng nhập Google sẽ ẩn)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI ---
# Nếu để trống, hệ thống dùng mock response cho development
OPENAI_API_KEY=""
# Model mặc định cho AI (VD: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# --- TTS ---
# Nếu để trống, dùng browser SpeechSynthesis
TTS_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"