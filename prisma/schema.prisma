// LINGUAFLOW - Prisma Schema
// -----------------------------------------------------------
// DEV: SQLite. PRODUCTION: đổi `provider` thành "postgresql"
// và đổi DATABASE_URL trong .env là đủ (schema không dùng
// feature riêng của một DB engine, enum đều là String).
// -----------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== AUTH ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  // Learning profile
  language       String    @default("both") // "english" | "chinese" | "both"
  goalDaily      Int       @default(20)
  xp             Int       @default(0)
  level          Int       @default(1)
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  onboarded      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  settings           UserSettings?
  userVocabularies   UserVocabulary[]
  reviewSessions     ReviewSession[]
  reviewRecords      ReviewRecord[]
  quizzes            Quiz[]
  achievements       UserAchievement[]
  learningSessions   LearningSession[]
  dailyProgress      DailyProgress[]
  aiConversations    AIConversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  bio              String?
  nativeLanguage   String   @default("vi")
  englishLevel     String? // beginner | elementary | intermediate | upper_intermediate | advanced
  chineseLevel     String? // hsk1..hsk6
  motivation       String? // giao_tu_luc ... ielts, toeic...
  dailyGoalMinutes Int      @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== VOCABULARY ====================

model Vocabulary {
  id                 String   @id @default(cuid())
  language           String // "english" | "chinese"
  word               String
  normalizedWord     String // không dấu / lower case - dùng cho search
  pronunciation      String?
  pinyin             String?
  traditional        String?
  meaningVi          String
  partOfSpeech       String?
  exampleSentence    String?
  exampleTranslation String?
  charAnalysis       String?
  difficulty         Int      @default(1) // 1..5
  level              String? // CEFR (EN) | HSK (CN)
  audioUrl           String?
  isCommon           Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics          TopicVocabulary[]
  userVocabularies UserVocabulary[]
  reviewRecords    ReviewRecord[]
  quizQuestions    QuizQuestion[]

  @@unique([language, word])
  @@index([normalizedWord])
  @@index([language, difficulty])
}

model Topic {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameVi      String
  description String
  language    String // "english" | "chinese"
  emoji       String  @default("📘")
  difficulty  Int     @default(1)
  estMinutes  Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vocabularies TopicVocabulary[]
}

model TopicVocabulary {
  topicId      String
  vocabularyId String
  order        Int      @default(0)

  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([topicId, vocabularyId])
  @@index([vocabularyId])
}

// ==================== LEARNING / SRS ====================

model UserVocabulary {
  id              String    @id @default(cuid())
  userId          String
  vocabularyId    String
  status          String    @default("new") // "new" | "learning" | "review" | "mastered"
  easeFactor      Float     @default(2.5)
  interval        Int       @default(0)
  repetitionCount Int       @default(0)
  masteryLevel    Int       @default(0) // 0..5
  nextReviewAt    DateTime?
  lastReviewedAt  DateTime?
  correctCount    Int       @default(0)
  incorrectCount  Int       @default(0)
  isSaved         Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary    Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  reviewRecords ReviewRecord[]

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@index([userId, status])
}

model ReviewSession {
  id           String    @id @default(cuid())
  userId       String
  mode         String    @default("review") // "new" | "review" | "mixed" | "learn"
  language     String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsStudied Int       @default(0)
  correct      Int       @default(0)
  incorrect    Int       @default(0)
  xpEarned     Int       @default(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewRecords ReviewRecord[]

  @@index([userId, startedAt])
}

model ReviewRecord {
  id              String          @id @default(cuid())
  userId          String
  userVocabularyId String
  vocabularyId    String
  sessionId       String?
  result          String // "again" | "hard" | "good" | "easy" | "correct" | "incorrect"
  responseMs      Int?
  createdAt       DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userVocabulary  UserVocabulary  @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)
  vocabulary      Vocabulary      @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  session         ReviewSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([vocabularyId])
}

model LearningSession {
  id           String    @id @default(cuid())
  userId       String
  mode         String    @default("flashcard")
  language     String?
  topicId      String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsStudied Int       @default(0)
  xpEarned     Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ==================== PRACTICE / QUIZ ====================

model Quiz {
  id             String    @id @default(cuid())
  userId         String
  type           String // "multiple-choice" | "fill-blank" | "listening" | "translate" | "pinyin" | "hanzi" | "scramble"
  language       String?
  score          Int       @default(0)
  totalQuestions Int       @default(0)
  completedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([userId, completedAt])
}

model QuizQuestion {
  id             String   @id @default(cuid())
  quizId         String
  vocabularyId   String?
  question       String
  userAnswer     String?
  correctAnswer  String
  isCorrect      Boolean  @default(false)
  createdAt      DateTime @default(now())

  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  @@index([quizId])
}

// ==================== GAMIFICATION ====================

model Achievement {
  id          String  @id @default(cuid())
  code        String  @unique
  titleVi     String
  description String
  icon        String  @default("🏅")
  xpReward    Int     @default(0)
  category    String  @default("general")

  createdAt DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model DailyProgress {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @default(now()) // đầu ngày (local date lúc tạo)
  wordsLearned      Int      @default(0)
  wordsReviewed     Int      @default(0)
  correctAnswers    Int      @default(0)
  incorrectAnswers  Int      @default(0)
  xpEarned          Int      @default(0)
  minutesLearned    Int      @default(0)
  goalAchieved      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model UserSettings {
  id          String  @id @default(cuid())
  userId      String  @unique
  theme       String  @default("system") // "light" | "dark" | "system"
  dailyGoal   Int     @default(20)
  language    String  @default("both")
  englishLevel String?
  chineseLevel String?
  motivation  String?
  soundEnabled Boolean @default(true)
  ttsRate     Float   @default(1.0)
  notifyReviews Boolean @default(true)
  notifyStreak  Boolean @default(true)
  notifyAchievements Boolean @default(true)
  dailyReminder String? // "HH:mm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== AI ====================

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Cuộc trò chuyện")
  provider  String   @default("mock") // "openai" | "mock"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
